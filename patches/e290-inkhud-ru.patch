+constexpr bool sameText(const char *a, const char *b)
+{
+    while (*a && *a == *b) {
+        ++a;
+        ++b;
+    }
+    return *a == *b;
+}
+constexpr const char *translate(const char *text)
+{
+    if (!text)
+        return "";
+    for (const auto &entry : translations)
+        if (sameText(text, entry.english))
+            return entry.russian;
+    return text;
+}
+#else
+constexpr const char *translate(const char *text)
+{
+    return text;
+}
+#endif
+} // namespace NicheGraphics::InkHUD
+#define INKHUD_TEXT(text) NicheGraphics::InkHUD::translate(text)
