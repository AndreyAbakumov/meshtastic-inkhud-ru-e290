+// Input is already parsed into one byte per glyph, so removing a byte never splits UTF-8.
+std::string InkHUD::Applet::ellipsizeToWidth(std::string text, uint16_t maxWidth)
+{
+    for (char &c : text) {
+        if (c == '\n' || c == '\r')
+            c = ' ';
+    }
+    constexpr const char *ellipsis = "...";
+    if (maxWidth == 0)
+        return "";
+    if (getTextWidth(text) <= maxWidth)
+        return text;
+    if (getTextWidth(ellipsis) > maxWidth)
+        return "";
+    while (!text.empty() && getTextWidth(text + ellipsis) > maxWidth)
+        text.pop_back();
+    return text + ellipsis;
+}
