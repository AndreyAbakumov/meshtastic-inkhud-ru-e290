+#pragma once
+#if defined(MESHTASTIC_INCLUDE_INKHUD) && defined(HELTEC_VISION_MASTER_E290)
+#include "UnreadInbox.h"
+#include "concurrency/OSThread.h"
+#include "graphics/niche/InkHUD/SystemApplet.h"
+
+namespace NicheGraphics::InkHUD
+{
+class LockScreenApplet : public SystemApplet, public concurrency::OSThread
+{
+  public:
+    LockScreenApplet();
+    static LockScreenApplet *instance;
+    static bool input(bool unlock = false);
+    static void markRead(const MessageStore::Message &message, bool direct);
+    void receive(const meshtastic_MeshPacket *packet, const MessageStore::Message &message);
+    void open();
+    void setTimeout(uint8_t minutes);
+    uint8_t timeout() const { return options.minutes; }
+    void clearUnread();
+    void setEconomy(bool enabled);
+    bool economyMode() const { return economy != 0; }
+    void onRender(bool full) override;
+    void onForeground() override;
+    void onBackground() override;
+    void onButtonLongPress() override;
+
+  protected:
+    int32_t runOnce() override;
+
+  private:
+    struct Options {
+        uint32_t version = 1;
+        uint8_t minutes = 0;
+    } options;
+    UnreadInbox inbox;
+    uint32_t lastInput = 0;
+    uint32_t minute = UINT32_MAX;
+    uint32_t economy = 0;
+    uint32_t lastFullRefresh = 0;
+    uint32_t lastClockRefresh = 0;
+    int32_t nextDelay();
+    bool canOpen();
+};
+} // namespace NicheGraphics::InkHUD
+#endif
diff --git a/src/graphics/niche/InkHUD/Applets/System/LockScreen/UnreadInbox.h b/src/graphics/niche/InkHUD/Applets/System/LockScreen/UnreadInbox.h
new file mode 100644
index 000000000..51f9666eb
--- /dev/null
+++ b/src/graphics/niche/InkHUD/Applets/System/LockScreen/UnreadInbox.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <string>
+
+namespace NicheGraphics::InkHUD
+{
+class UnreadInbox
+{
+  public:
+    struct Entry {
+        uint32_t id, sender, timestamp;
+        uint8_t channel;
+        bool direct;
+        std::string text;
+    };
+    static constexpr size_t capacity = 20;
+    std::deque<Entry> entries;
+
+    bool add(Entry entry)
+    {
+        if (entry.id && std::find(recent.begin(), recent.end(), std::make_pair(entry.sender, entry.id)) != recent.end())
+            return false;
+        if (entry.id) {
+            recent.emplace_back(entry.sender, entry.id);
+            if (recent.size() > 32)
+                recent.pop_front();
+        }
+        entry.text.resize(std::min<size_t>(entry.text.size(), 237));
+        entries.push_front(std::move(entry));
+        if (entries.size() > capacity)
+            entries.pop_back();
+        return true;
+    }
+
+    void read(uint32_t sender, uint32_t timestamp, uint8_t channel, bool direct, const std::string &text)
+    {
+        entries.erase(std::remove_if(entries.begin(), entries.end(),
+                                     [&](const Entry &e) {
+                                         return e.sender == sender && e.timestamp == timestamp && e.channel == channel &&
+                                                e.direct == direct && e.text == text;
+                                     }),
+                      entries.end());
+    }
+    void clear() { entries.clear(); }
+
+  private:
+    std::deque<std::pair<uint32_t, uint32_t>> recent;
+};
+} // namespace NicheGraphics::InkHUD
