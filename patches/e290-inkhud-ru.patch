diff --git a/src/graphics/niche/InkHUD/Applets/System/LockScreen/LockScreenApplet.cpp b/src/graphics/niche/InkHUD/Applets/System/LockScreen/LockScreenApplet.cpp
new file mode 100644
index 000000000..fa79f166b
--- /dev/null
+++ b/src/graphics/niche/InkHUD/Applets/System/LockScreen/LockScreenApplet.cpp
@@ -0,0 +1,234 @@
+#if defined(MESHTASTIC_INCLUDE_INKHUD) && defined(HELTEC_VISION_MASTER_E290)
+#include "LockScreenApplet.h"
+#include "PowerStatus.h"
+#include "RTC.h"
+#include "graphics/niche/InkHUD/Applets/System/Notification/NotificationApplet.h"
+#include "graphics/niche/InkHUD/InkHUD.h"
+#include "graphics/niche/Utils/FlashData.h"
+#include "mesh/Throttle.h"
+#include "meshUtils.h"
+#include <ctime>
+
+using namespace NicheGraphics;
+InkHUD::LockScreenApplet *InkHUD::LockScreenApplet::instance = nullptr;
+
+InkHUD::LockScreenApplet::LockScreenApplet() : concurrency::OSThread("InkHUDLock", 1000)
+{
+    instance = this;
+    Options loaded;
+    if (FlashData<Options>::load(&loaded, "lockscreen") && loaded.version == 1 &&
+        (loaded.minutes == 0 || loaded.minutes == 1 || loaded.minutes == 5 || loaded.minutes == 15))
+        options = loaded;
+    uint32_t loadedMode = 0;
+    if (FlashData<uint32_t>::load(&loadedMode, "lockscreen-mode") && loadedMode <= 1)
+        economy = loadedMode;
+    lastInput = millis();
+    setIntervalFromNow(nextDelay());
+}
+
+bool InkHUD::LockScreenApplet::input(bool unlock)
+{
+    if (!instance)
+        return false;
+    instance->lastInput = millis();
+    instance->setIntervalFromNow(instance->nextDelay());
+    if (!instance->isForeground())
+        return false;
+    for (auto *a : instance->inkhud->systemApplets) {
+        if (a == instance)
+            break;
+        if (a->isForeground() && a->handleInput)
+            return false;
+    }
+    if (unlock)
+        instance->onButtonLongPress();
+    return true;
+}
+
+int32_t InkHUD::LockScreenApplet::nextDelay()
+{
+    if (isForeground()) {
+        const uint32_t seconds = economyMode() ? 300 : 60;
+        return (seconds - getValidTime(RTCQuality::RTCQualityDevice, true) % seconds) * 1000;
+    }
+    if (!options.minutes)
+        return INT32_MAX;
+    const uint32_t timeoutMs = options.minutes * 60000UL;
+    const uint32_t elapsed = uint32_t(millis() - lastInput);
+    if (!Throttle::isWithinTimespanMs(lastInput, timeoutMs))
+        return 1;
+    return timeoutMs - elapsed;
+}
+
+void InkHUD::LockScreenApplet::setEconomy(bool enabled)
+{
+    economy = enabled ? 1 : 0;
+    FlashData<uint32_t>::save(&economy, "lockscreen-mode");
+    input();
+}
+
+bool InkHUD::LockScreenApplet::canOpen()
+{
+    for (auto *a : inkhud->systemApplets) {
+        if (a == this)
+            break;
+        if (a->isForeground())
+            return false;
+    }
+    return !inkhud->getSystemApplet("Menu")->isForeground();
+}
+
+void InkHUD::LockScreenApplet::open()
+{
+    if (canOpen())
+        bringToForeground();
+}
+
+void InkHUD::LockScreenApplet::setTimeout(uint8_t minutes)
+{
+    if (minutes != 0 && minutes != 1 && minutes != 5 && minutes != 15)
+        return;
+    options.minutes = minutes;
+    FlashData<Options>::save(&options, "lockscreen");
+    input();
+}
+
+void InkHUD::LockScreenApplet::clearUnread()
+{
+    inbox.clear();
+    if (isForeground())
+        requestUpdate();
+}
+
+void InkHUD::LockScreenApplet::receive(const meshtastic_MeshPacket *packet, const MessageStore::Message &message)
+{
+    if (!isBroadcast(packet->to) && packet->to != nodeDB->getNodeNum())
+        return;
+    if (inbox.add(
+            {packet->id, message.sender, message.timestamp, message.channelIndex, !isBroadcast(packet->to), message.text}) &&
+        isForeground())
+        requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+}
+
+void InkHUD::LockScreenApplet::markRead(const MessageStore::Message &message, bool direct)
+{
+    if (instance && message.sender && !instance->isForeground())
+        instance->inbox.read(message.sender, message.timestamp, message.channelIndex, direct, message.text);
+}
+
+void InkHUD::LockScreenApplet::onForeground()
+{
+    lockRendering = lockRequests = handleInput = true;
+    static_cast<NotificationApplet *>(inkhud->getSystemApplet("Notification"))->dismiss();
+    minute = getValidTime(RTCQuality::RTCQualityDevice, true) / 60;
+    lastClockRefresh = lastFullRefresh = millis();
+    setIntervalFromNow(nextDelay());
+    inkhud->forceUpdate(Drivers::EInk::UpdateTypes::FULL);
+}
+
+void InkHUD::LockScreenApplet::onBackground()
+{
+    lockRendering = lockRequests = handleInput = false;
+    lastInput = millis();
+    setIntervalFromNow(nextDelay());
+    static_cast<NotificationApplet *>(inkhud->getSystemApplet("Notification"))->dismiss();
+    inkhud->forceUpdate(Drivers::EInk::UpdateTypes::FULL);
+}
+
+void InkHUD::LockScreenApplet::onButtonLongPress()
+{
+    sendToBackground();
+}
+
+int32_t InkHUD::LockScreenApplet::runOnce()
+{
+    if (!isForeground()) {
+        if (!canOpen())
+            lastInput = millis();
+        else if (options.minutes && !Throttle::isWithinTimespanMs(lastInput, options.minutes * 60000UL))
+            open();
+    } else {
+        const uint32_t nowMinute = getValidTime(RTCQuality::RTCQualityDevice, true) / 60;
+        const uint32_t step = economyMode() ? 5 : 1;
+        if (nowMinute / step != minute / step || !Throttle::isWithinTimespanMs(lastClockRefresh, step * 60000UL)) {
+            minute = nowMinute;
+            lastClockRefresh = millis();
+            const uint32_t fullInterval = (economyMode() ? 30 : 10) * 60000UL;
+            const bool clean = !Throttle::isWithinTimespanMs(lastFullRefresh, fullInterval);
+            if (clean)
+                lastFullRefresh = millis();
+            requestUpdate(clean ? Drivers::EInk::UpdateTypes::FULL : Drivers::EInk::UpdateTypes::FAST);
+        }
+    }
+    return nextDelay();
+}
+
+void InkHUD::LockScreenApplet::onRender(bool full)
+{
+    fillRect(0, 0, width(), height(), WHITE);
+    const int16_t split = width() * 0.42f;
+    const int16_t footer = height() - fontSmall.lineHeight();
+    setFont(fontSmall);
+    const int charge = powerStatus ? powerStatus->getBatteryChargePercent() : -1;
+    const bool validCharge = powerStatus && powerStatus->getHasBattery() && charge >= 0 && charge <= 100;
+    const std::string batteryText = validCharge ? to_string(charge) + "%" : "--%";
+    const int16_t batteryLeft = (split - (17 + getTextWidth(batteryText))) / 2;
+    drawRect(batteryLeft, 4, 12, 9, BLACK);
+    fillRect(batteryLeft + 12, 6, 2, 5, BLACK);
+    if (validCharge)
+        fillRect(batteryLeft + 2, 6, (8 * charge) / 100, 5, BLACK);
+    printAt(batteryLeft + 17, 1, batteryText);
+
+    drawLine(split, 0, split, footer - 2, BLACK);
+    setFont(fontLarge);
+    std::string clock = getTimeString();
+    if (clock.empty())
+        clock = "--:--";
+    if (getTextWidth(clock) > split - 8)
+        setFont(fontMedium);
+    if (getTextWidth(clock) > split - 8)
+        setFont(fontSmall);
+    if (getTextWidth(clock) > split - 8) {
+        const uint32_t local = getValidTime(RTCQuality::RTCQualityDevice, true);
+        char compact[6];
+        snprintf(compact, sizeof(compact), "%02u:%02u", unsigned(local / 3600 % 24), unsigned(local / 60 % 60));
+        clock = compact;
+    }
+    printAt(split / 2, footer / 2 - 10, clock, CENTER, MIDDLE);
+    setFont(fontSmall);
+    uint32_t epoch = getValidTime(RTCQuality::RTCQualityDevice, true);
+    if (clock != "--:--") {
+        time_t t = epoch;
+        struct tm date;
+        gmtime_r(&t, &date); // RTC local time already includes the configured timezone.
+        char dateText[12];
+        strftime(dateText, sizeof(dateText), split < 80 ? "%d.%m" : "%d.%m.%Y", &date);
+        printAt(split / 2, footer / 2 + 18, ellipsizeToWidth(dateText, split - 6), CENTER, TOP);
+    } else {
+        printWrapped(3, footer / 2 + 18, split - 6, INKHUD_TEXT("Set time in app"));
+    }
+    const int16_t left = split + 5;
+    const uint16_t available = width() - left - 3;
+    std::string title = INKHUD_TEXT("Unread: ") + to_string(inbox.entries.size());
+    printAt(left, 0, ellipsizeToWidth(title, available));
+    int16_t y = fontSmall.lineHeight() + 3;
+    if (inbox.entries.empty())
+        printWrapped(left, y, available, INKHUD_TEXT("No unread messages"));
+    size_t shown = 0;
+    const int16_t rowHeight = 2 * fontSmall.lineHeight() + 3;
+    while (shown < inbox.entries.size() && y + rowHeight <= footer - fontSmall.lineHeight()) {
+        const auto &entry = inbox.entries[shown];
+        auto *node = nodeDB->getMeshNode(entry.sender);
+        std::string sender = node ? parseShortName(node) : hexifyNodeNum(entry.sender);
+        if (entry.direct)
+            sender = INKHUD_TEXT("DM: ") + sender;
+        printAt(left, y, ellipsizeToWidth(sender, available));
+        printAt(left, y + fontSmall.lineHeight(), ellipsizeToWidth(parse(entry.text), available));
+        y += rowHeight;
+        ++shown;
+    }
+    if (shown < inbox.entries.size())
+        printAt(left, y, ellipsizeToWidth(INKHUD_TEXT("More: ") + to_string(inbox.entries.size() - shown), available));
+    printAt(width() / 2, height(), INKHUD_TEXT("Hold to unlock"), CENTER, BOTTOM);
+}
+#endif
